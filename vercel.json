{
  "version": 2,
  "buildCommand": "npx prisma generate --schema=server/prisma/schema.prisma && npm --workspace=server run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    }
  ]
}
