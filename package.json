{
  "name": "pawty-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Pawty — Hệ sinh thái số dành riêng cho người nuôi thú cưng tại đô thị Việt Nam",
  "workspaces": [
    "packages/*",
    "apps/web",
    "server"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:server": "npm --workspace=server run start:dev",
    "server:dev": "npm --workspace=server run start:dev",
    "server": "npm --workspace=server run start",
    "reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:3000 tcp:3000",
    "dev:mobile": "cd apps/mobile && npm run start",
    "dev:mobile:usb": "cd apps/mobile && npx expo start --localhost",
    "mobile": "cd apps/mobile && npm run start",
    "mobile:android": "powershell -ExecutionPolicy Bypass -File ./install-app.ps1",
    "mobile:clear": "cd apps/mobile && npx expo start --go -c",
    "build": "npm --workspace=apps/web run build && npm --workspace=server run build",
    "build:web": "npm --workspace=apps/web run build",
    "build:server": "npm --workspace=server run build",
    "db:deploy:prod": "node scripts/deploy-db-prod.js",
    "typecheck": "npm --workspace=apps/web run typecheck && npm --workspace=server run typecheck"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}