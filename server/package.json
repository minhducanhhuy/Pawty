{
  "name": "@pawty/server",
  "version": "1.0.0",
  "private": true,
  "description": "Pawty NestJS Backend API + Socket.io Gateway + PostGIS + Prisma",
  "scripts": {
    "dev": "npm run start:dev",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/main.js",
    "start:dev": "tsc -p tsconfig.json && node dist/server/src/main.js",
    "db:push": "prisma db push",
    "db:seed": "tsc -p tsconfig.json && node dist/server/src/data/seed-db.js",
    "seed": "npm run db:seed",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "npm run db:seed"
  },
  "dependencies": {
    "@pawty/types": "*",
    "@pawty/utils": "*",
    "@pawty/validators": "*",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3",
    "typescript": "^5.8.3"
  }
}
