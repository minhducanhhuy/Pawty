// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum PetSpecies {
  dog
  cat
}

enum PetGender {
  male
  female
}

enum PetSize {
  small
  medium
  large
}

enum MatchStatus {
  liked
  disliked
  matched
}

enum AppointmentStatus {
  pending
  confirmed
  rejected
  reported_flake
  completed
}

model User {
  id                 String       @id @default(uuid())
  phone              String       @unique
  fullName           String       @map("full_name")
  nickname           String?
  avatarUrl          String       @map("avatar_url")
  isVerified         Boolean      @default(false) @map("is_verified")
  isVip              Boolean      @default(false) @map("is_vip")
  vipExpiresAt       DateTime?    @map("vip_expires_at")
  dailySwipesCount   Int          @default(0) @map("daily_swipes_count")
  latitude           Float
  longitude          Float
  condoComplex       String       @map("condo_complex")
  flakeReportsCount  Int          @default(0) @map("flake_reports_count")
  isBannedSwiping    Boolean      @default(false) @map("is_banned_swiping")
  banUntil           DateTime?    @map("ban_until")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  pets               Pet[]
  momentLikes        MomentLike[]
  transactions       Transaction[]

  @@map("users")
}

model Pet {
  id                 String       @id @default(uuid())
  userId             String       @map("user_id")
  name               String
  species            PetSpecies
  breed              String
  gender             PetGender
  isNeutered         Boolean      @default(false) @map("is_neutered")
  ageYears           Int          @default(0) @map("age_years")
  ageMonths          Int          @default(0) @map("age_months")
  weightKg           Float        @map("weight_kg")
  size               PetSize
  isVaccinated       Boolean      @default(true) @map("is_vaccinated")
  lastVaccineDate    String?      @map("last_vaccine_date")
  vaccineDetails     String?      @map("vaccine_details")
  bio                String?
  tags               String[]
  habitsGood         String[]     @map("habits_good")
  habitsBad          String[]     @map("habits_bad")
  avatarUrl          String       @map("avatar_url")
  photos             String[]
  createdAt          DateTime     @default(now()) @map("created_at")

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moments            PetMoment[]

  @@map("pets")
}

model PetMoment {
  id          String       @id @default(uuid())
  petId       String       @map("pet_id")
  mediaUrl    String       @map("media_url")
  mediaType   String       @default("image") @map("media_type")
  caption     String
  likesCount  Int          @default(0) @map("likes_count")
  createdAt   DateTime     @default(now()) @map("created_at")

  pet         Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  likes       MomentLike[]

  @@map("pet_moments")
}

model MomentLike {
  id        String    @id @default(uuid())
  momentId  String    @map("moment_id")
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")

  moment    PetMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
  @@map("moment_likes")
}

model WalkAppointment {
  id                   String            @id @default(uuid())
  roomId               String            @map("room_id")
  senderPetId          String            @map("sender_pet_id")
  receiverPetId        String            @map("receiver_pet_id")
  scheduledTime        DateTime          @map("scheduled_time")
  displayTime          String            @map("display_time")
  placeName            String            @map("place_name")
  placeAddress         String            @map("place_address")
  placeThumbnail       String            @map("place_thumbnail")
  placeDistanceMeters  Int               @map("place_distance_meters")
  note                 String?
  status               AppointmentStatus @default(pending)
  createdAt            DateTime          @default(now()) @map("created_at")

  @@map("walk_appointments")
}

model SosAlert {
  id               String       @id @default(uuid())
  petName          String       @map("pet_name")
  species          PetSpecies
  breed            String
  petPhotoUrl      String       @map("pet_photo_url")
  latitude         Float
  longitude        Float
  lastSeenAddress  String       @map("last_seen_address")
  radiusKm         Int          @default(3) @map("radius_km")
  rewardAmountVnd  String       @map("reward_amount_vnd")
  contactPhone     String       @map("contact_phone")
  notes            String
  status           String       @default("active")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("sos_alerts")
}

model Transaction {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  type            String
  amountVnd       Int          @map("amount_vnd")
  paymentGateway  String       @default("vietqr") @map("payment_gateway")
  paymentCode     String       @map("payment_code")
  status          String       @default("pending")
  createdAt       DateTime     @default(now()) @map("created_at")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}
