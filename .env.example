# Pawty Monorepo Environment Variables Template
PORT=3000

# Backend Server & Database
DATABASE_URL="postgresql://postgres:123456@127.0.0.1:5432/pawty?schema=public"

# Google Gemini Vision API for Pet Sighting Tracing
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary Storage Configuration for Media Uploads (Avatars, Pets, Moments, SOS)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
