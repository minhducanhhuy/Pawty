{
  "expo": {
    "name": "Pawty — Hệ sinh thái Thú cưng",
    "slug": "pawty-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pawty-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/pawty-logo-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFBF7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pawty.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pawty cần quyền vị trí để hiển thị các bạn cún và boss xung quanh bạn."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/pawty-icon.png",
        "backgroundColor": "#FDFBF7"
      },
      "package": "com.pawty.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pawty cần quyền vị trí để hiển thị các bạn cún và boss xung quanh bạn."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0e8a7d89-db3b-4944-bfb7-a7d84fdfba67"
      }
    },
    "owner": "turtlexe"
  }
}
