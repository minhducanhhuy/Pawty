{
  "expo": {
    "name": "Pawty — Hệ sinh thái Thú cưng",
    "slug": "pawty-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pawty-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/pawty-logo-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFBF7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pawty.app",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/pawty-icon.png",
        "backgroundColor": "#FDFBF7"
      },
      "package": "com.pawty.app"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "0e8a7d89-db3b-4944-bfb7-a7d84fdfba67"
      }
    },
    "owner": "turtlexe"
  }
}
